# Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/sub4you

# Firebase Admin SDK (Keep secret on server only)
FIREBASE_PROJECT_ID=sub4you-platform
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@sub4you-platform.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# YouTube Data API v3 (Optional for public YouTube data extraction)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Initial Admin User
INITIAL_ADMIN_EMAIL=admin@sub4you.com
